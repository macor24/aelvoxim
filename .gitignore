# Test/coverage artifacts
.coverage
.coverage.*
htmlcov/

# esbuild output compiled from src/utils/time.ts for the frozen criteria
frontend/chatael/test/time.mjs

# Old backup — contents superseded by current src/
aelvoxim-1.0.1/
secrets.json
*.pem

# Deploy units contain DSN credentials — never commit
deploy/

# User data — never commit real conversations or local state
.metacore/
.aelvoxim/
frontend/chatael-v2/data/
frontend/chatael/data/

# Large / binary files (not source)
*.psd
*.zip
*.mp4
*.avi
*.mov
*.tar.gz
models/

# Internal planning & development docs (not for public)
docs/

# Windows reserved names — should never be tracked
nul

# Hermes agent config (local dev only)
.hermes/

# Vite/Node build artifacts
node_modules/

# Windows-MCP upstream files (not part of Aelvoxim)
Windows-MCP/.claude/
Windows-MCP/.github/
